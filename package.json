{
  "name": "mesanube-print-agent",
  "version": "1.4.0",
  "description": "Agente de impresión para Mesanube POS",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec electron . --watch src --ext js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:linux": "electron-builder --linux --publish=never"
  },
  "keywords": [
    "electron",
    "print",
    "pos",
    "receipt",
    "thermal-printer"
  ],
  "author": "Mesanube",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.4.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "hono": "^3.12.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.0",
    "i18next-electron-language-detector": "^0.0.10",
    "i18next-fs-backend": "^2.6.0",
    "koffi": "^3.1.5",
    "node-thermal-printer": "^4.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.mesanube.print-agent",
    "productName": "Mesanube Impresora",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "mesanube",
      "repo": "print-agent"
    },
    "files": [
      "src/**/*",
      "printerTestImage.png",
      "icon.png",
      "icon-16.png",
      "icon-32.png",
      "icon-32-checking.png",
      "icon-32-update-ready.png",
      "icon-96.png",
      "package.json",
      "!src/printing/native/cairo_printer.node"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis",
      "files": [
        "src/printing/native/cairo_printer.node"
      ]
    },
    "nsis": {
      "artifactName": "Mesanube-Impresora-Setup.${ext}"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
